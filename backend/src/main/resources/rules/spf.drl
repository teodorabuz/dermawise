package com.dermawise.backend.rules

import com.dermawise.backend.SkincareRequest
import com.dermawise.backend.SkincareResult
import com.dermawise.backend.Budzet
import com.dermawise.backend.IzlozenostSuncu
import com.dermawise.backend.TipKoze

rule "SPF - masna koza, ekonomican budzet, uglavnom u zatvorenom"
salience 70
when
	zahtev: SkincareRequest(budzet == Budzet.EKONOMICAN, izlozenostSuncu == IzlozenostSuncu.UGLAVNOM_U_ZATVORENOM)
	rezultat: SkincareResult(tipKoze == TipKoze.MASNA)
then
	rezultat.getJutarnjaRutina().setSpf("Balea Hidratantna dnevna krema za lice sa vitaminom E i aloe verom (SPF 15), 50 ml");
end

