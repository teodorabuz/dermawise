package com.dermawise.backend.rules

import com.dermawise.backend.SkincareRequest
import com.dermawise.backend.SkincareResult
import com.dermawise.backend.OsetljivostKoze

rule "Sklona iritacijama + Retinol"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.SKLONA_IRITACIJAMA)
	rezultat: SkincareResult(vecernjaRutina.aktivneSupstance contains "Retinol")
then
	rezultat.dodajUpozorenje("Zbog kože sklonoj iritacijama, preporuka je da retinol ne koristite češće od 1-2 puta nedeljno i u počnite sa nižim koncentracijama (npr. 0.01% - 0.03%).");
end

rule "Sklona iritacijama + Salicina kiselina"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.SKLONA_IRITACIJAMA)
	rezultat: SkincareResult(vecernjaRutina.aktivneSupstance contains "Salicilna kiselina")
then
	rezultat.dodajUpozorenje("Zbog kože sklonoj iritacijama, preporuka je da salicilnu kiselinu ne koristite češće od 1-2 puta nedeljno i u počnite sa nižom koncentracijom.");
end

rule "Sklona iritacijama + Glikolna kiselina"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.SKLONA_IRITACIJAMA)
	rezultat: SkincareResult(vecernjaRutina.aktivneSupstance contains "Glikolna kiselina")
then
	rezultat.dodajUpozorenje("Zbog kože sklonoj iritacijama, preporuka je da glikolnu kiselinu ne koristite češće od 1-2 puta nedeljno i u počnite sa nižom koncentracijom.");
end

rule "Sklona iritacijama + Vitamin C"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.SKLONA_IRITACIJAMA)
	rezultat: SkincareResult(jutarnjaRutina.aktivneSupstance contains "Vitamin C")
then
	rezultat.dodajUpozorenje("Zbog kože sklonoj iritacijama, preporuka je da vitamin C koristite u nižim koncentracijama (npr. 5-10%) i koristite ga svaki drugi/treći dan dok koža ne razvije toleranciju.");
end

rule "Konstantno perutanje + Retinol"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.KONSTANTNO_PERUTANJE)
	rezultat: SkincareResult(vecernjaRutina.aktivneSupstance contains "Retinol")
then
	rezultat.dodajUpozorenje("Zbog kože koja se konstantno peruta (to je znak oštećene barijere kože), preporuka je da retinol ne koristite dok se stanje kože ne stabilizuje kroz hidrataciju. Konsultovati se sa dermatologom pre nego što ga uvrstite u svoju rutinu.");
end

rule "Konstantno perutanje + Salicilna kiselina"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.KONSTANTNO_PERUTANJE)
	rezultat: SkincareResult(vecernjaRutina.aktivneSupstance contains "Salicilna kiselina")
then
	rezultat.dodajUpozorenje("Zbog kože koja se konstantno peruta (to je znak oštećene barijere kože), preporuka je da salicilnu kiselinu ne koristite dok se stanje kože ne stabilizuje kroz hidrataciju. Konsultovati se sa dermatologom pre nego što ga uvrstite u svoju rutinu.");
end

rule "Konstantno perutanje + Glikolna kiselina"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.KONSTANTNO_PERUTANJE)
	rezultat: SkincareResult(vecernjaRutina.aktivneSupstance contains "Glikolna kiselina")
then
	rezultat.dodajUpozorenje("Zbog kože koja se konstantno peruta (to je znak oštećene barijere kože), preporuka je da glikolnu kiselinu ne koristite dok se stanje kože ne stabilizuje kroz hidrataciju. Konsultovati se sa dermatologom pre nego što ga uvrstite u svoju rutinu.");
end

rule "Konstantno perutanje + Vitamin C"
salience 40
when
	SkincareRequest(osetljivostKoze == OsetljivostKoze.KONSTANTNO_PERUTANJE)
	rezultat: SkincareResult(jutarnjaRutina.aktivneSupstance contains "Vitamin C")
then
	rezultat.dodajUpozorenje("Zbog kože koja se konstantno peruta (to je znak oštećene barijere kože), preporuka je da vitamin C ne koristite dok se stanje kože ne stabilizuje kroz hidrataciju.");
end

rule "Osetljivost - konstantno perutanje, uklanjanje dodataka"
salience 39
when
    zahtev: SkincareRequest(osetljivostKoze == OsetljivostKoze.KONSTANTNO_PERUTANJE)
    rezultat: SkincareResult()
then
    rezultat.getDodaciRutini().setEsencija(null);
    rezultat.getDodaciRutini().setMaska(null);
    rezultat.getDodaciRutini().setAmpule(null);
    rezultat.getDodaciRutini().getUputstvo().clear();
    rezultat.getDodaciRutini().dodajUputstvo("Zbog trenutnog stanja kože (konstantno perutanje), dodatni koraci u nezi (esencija, maska, ampule) su privremeno izostavljeni. Fokusirajte se na osnovnu rutinu i hidrataciju dok se stanje kože ne stabilizuje.");
	rezultat.dodajUpozorenje("Zbog konstantnog perutanja kože (znak oštećene kožne barijere), dodatni koraci u nezi (esencija, maska, ampule) su privremeno izostavljeni dok se stanje kože ne stabilizuje.");
end

rule "Osetljivost - sklona iritacijama, samo maska"
salience 39
when
    zahtev: SkincareRequest(osetljivostKoze == OsetljivostKoze.SKLONA_IRITACIJAMA)
    rezultat: SkincareResult()
then
    rezultat.getDodaciRutini().setEsencija(null);
    rezultat.getDodaciRutini().setAmpule(null);
    rezultat.getDodaciRutini().getUputstvo().clear();
    rezultat.getDodaciRutini().dodajUputstvo("Zbog trenutnog stanja kože (koža koja je sklona iritacijama i crvenilu), dodatni koraci u nezi (esencija i ampule) su privremeno izostavljeni. Fokusirajte se na osnovnu rutinu i hidrataciju dok se stanje kože ne stabilizuje, a u međuvremenu do 2-3 puta nedeljno stavljajte preporučenu masku za lice.");
    rezultat.dodajUpozorenje("Zbog sklonosti ka iritacijama i crvenilu, preporučuje se koristiti samo masku iz preporučene rutine, dok se esencija i ampule privremeno izostavljaju kako bi se smanjio rizik od dodatne iritacije.");
end
