package com.dermawise.backend.rules

import com.dermawise.backend.SkincareRequest
import com.dermawise.backend.SkincareResult
import com.dermawise.backend.Budzet
import com.dermawise.backend.TipKoze

rule "Dodaci - akne, ekonomican budzet"
salience 70
when
	zahtev: SkincareRequest(budzet == Budzet.EKONOMICAN)
	rezultat: SkincareResult(kategorijaNege contains "Akne")
then
	rezultat.getDodaciRutini().setEsencija("Cosrx Advanced Snail 96 Mucin Power Essence");
	rezultat.getDodaciRutini().setMaska("Balea HBN (Hydro Balance / Clear)");
	if(rezultat.getTipKoze() != TipKoze.MASNA && rezultat.getTipKoze() != TipKoze.KOMBINOVANA){
		rezultat.getDodaciRutini().setAmpule("Balea Ampule sa Vitaminom C ili Niacinamidom (set od 7 komada)");
	}
	rezultat.getDodaciRutini().setUputstvo("Masku je preporučljivo koristiti 2-3 puta nedeljno nakon što na kožu nanesete toner, kako bi koža što bolje upila serum iz maske. Esencije i ampule kombinujte alternativnim danima, najčešće 2 puta nedeljno, po mogućstvu u jutarnjoj rutini, pre nego što nanesete dnevnu kremu i SPF.");
end

