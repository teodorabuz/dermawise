rule "Godine - napomena kada su akne prioritet"
salience 65
when
	SkincareRequest(godine > 25)
	rezultat: SkincareResult(kategorijaNege contains "Akne")
then
	rezultat.dodajNapomenu("S obzirom na vaše godine, preventivna upotreba retinola bi bila korisna. Preporučuje se da se prvo reši problem akni, a zatim uvede retinol u večernju rutinu.");
end

rule "Godine - napomena kada je pigmentacija prioritet"
salience 65
when
	SkincareRequest(godine > 25)
	rezultat: SkincareResult(kategorijaNege contains "Pigmentacija", kategorijaNege excludes "Akne")
then
	rezultat.dodajNapomenu("S obzirom na vaše godine, preventivna upotreba retinola bi bila korisna. Trenutna večernja rutina koristi tretman za pigmentaciju - retinol možete uvesti nakon završetka tog tretmana ili alternirati večerima.");
end







