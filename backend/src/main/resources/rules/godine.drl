package com.dermawise.backend.rules

import com.dermawise.backend.SkincareRequest
import com.dermawise.backend.SkincareResult
import com.dermawise.backend.Budzet
import com.dermawise.backend.Sastojak

rule "Godine - preventivni retinol, ekonomican budzet (vec koriscen retinol)"
salience 70
no-loop true
when
	zahtev: SkincareRequest(godine > 25, budzet == Budzet.EKONOMICAN, korisceniSastojci contains Sastojak.RETINOL)
	rezultat: SkincareResult(kategorijaNege contains "Odrzavanje", kategorijaNege excludes "Akne", kategorijaNege excludes "Pigmentacija", kategorijaNege excludes "AntiAge", vecernjaRutina.aktivneSupstance excludes "Retinol")
then
	rezultat.getVecernjaRutina().dodajSerum("Revox B77 Serum za lice - RETINOL, 30 ml");
	rezultat.getVecernjaRutina().dodajAktivnuSupstancu("Retinol");
	update(rezultat);
end

rule "Godine - preventivni retinol, ekonomican budzet (nije koriscen retinol)"
salience 70
no-loop true
when
	zahtev: SkincareRequest(godine > 25, budzet == Budzet.EKONOMICAN, korisceniSastojci excludes Sastojak.RETINOL)
	rezultat: SkincareResult(kategorijaNege contains "Odrzavanje", kategorijaNege excludes "Akne", kategorijaNege excludes "Pigmentacija", kategorijaNege excludes "AntiAge", vecernjaRutina.aktivneSupstance excludes "Retinol")
then
	rezultat.getVecernjaRutina().dodajSerum("Balea Beauty Collagen Retinol serum za lice, 30 ml");
	rezultat.getVecernjaRutina().dodajAktivnuSupstancu("Retinol");
	update(rezultat);
end

